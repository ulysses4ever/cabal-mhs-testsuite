 Cabal/src/Distribution/Simple/MHS.hs      | 96 +++--------------------
 changelog.d/pr-11392.md                   |  5 ++
 3 files changed, 21 insertions(+), 88 deletions(-)

diff --git a/Cabal/src/Distribution/Simple/Compiler.hs b/Cabal/src/Distribution/Simple/Compiler.hs
index 3a0aa4c91..79ef56cda 100644
--- a/Cabal/src/Distribution/Simple/Compiler.hs
+++ b/Cabal/src/Distribution/Simple/Compiler.hs
@@ -448,8 +448,14 @@ parmakeSupported :: Compiler -> Bool
 parmakeSupported = ghcSupported "Support parallel --make"
 
 -- | Does this compiler support reexported-modules?
+--
+-- MicroHs sees all the modules of the packages it loads, which include the
+-- dependencies of the packages a component depends on, so the modules that a
+-- package re-exports are visible to the components depending on it, as long
+-- as they are not renamed.
 reexportedModulesSupported :: Compiler -> Bool
-reexportedModulesSupported = ghcSupported "Support reexported-modules"
+reexportedModulesSupported comp =
+  compilerFlavor comp == MHS || ghcSupported "Support reexported-modules" comp
 
 -- | Does this compiler support thinning/renaming on package flags?
 renamingPackageFlagsSupported :: Compiler -> Bool
diff --git a/Cabal/src/Distribution/Simple/MHS.hs b/Cabal/src/Distribution/Simple/MHS.hs
index 71e00699b..f73e7ebef 100644
--- a/Cabal/src/Distribution/Simple/MHS.hs
+++ b/Cabal/src/Distribution/Simple/MHS.hs
@@ -141,98 +141,20 @@ configure verbosity hcPath progdb = do
 mhsLanguages :: [(Language, CompilerFlag)]
 mhsLanguages = [(lang, "") | lang <- knownLanguages]
 
--- | The extensions that MicroHs supports. They are always enabled, except for
--- CPP. See <https://github.com/augustss/MicroHs/wiki/Language>.
+-- | The extensions that MicroHs accepts: all of them. The extensions that mhs
+-- implements are always on, except for CPP, and it ignores the LANGUAGE
+-- pragmas of the others, so a package is not rejected for the extensions it
+-- declares, which are often used only on the GHC side of a conditional. A
+-- package that does need an extension that mhs does not implement fails when
+-- mhs meets the syntax. The extensions that mhs implements are listed at
+-- <https://github.com/augustss/MicroHs/wiki/Language>.
 mhsLanguageExtensions :: [(Extension, Maybe CompilerFlag)]
 mhsLanguageExtensions =
   (EnableExtension CPP, Just "-XCPP")
-    : [(EnableExtension ext, Nothing) | ext <- alwaysOn]
-    ++ [(DisableExtension ext, Nothing) | ext <- alwaysOff]
+    : [(EnableExtension ext, Nothing) | ext <- knownExtensions, ext /= CPP]
+    ++ [(DisableExtension ext, Nothing) | ext <- knownExtensions]
     ++ [(UnknownExtension ext, Nothing) | ext <- mhsSpecific]
   where
-    alwaysOn =
-      [ AllowAmbiguousTypes
-      , BangPatterns
-      , BinaryLiterals
-      , BlockArguments
-      , CApiFFI
-      , ConstrainedClassMethods
-      , ConstraintKinds
