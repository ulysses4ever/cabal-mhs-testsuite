+-- | The macros of the @cabal_macros.h@ for the given configured package, as
+-- @-D@ options of the C preprocessor, for a compiler that cannot have its
+-- preprocessor include a file: MicroHs passes on to cpphs only the @-D@ and
+-- @-I@ options it is given. As in the header, the first definition of a macro
+-- wins.
+generateCabalMacrosOptions :: PackageDescription -> LocalBuildInfo -> ComponentLocalBuildInfo -> [String]
+generateCabalMacrosOptions pkg_descr lbi clbi =
+  [ "-D" ++ lhs ++ "=" ++ rhs
+  | (_, lhs, rhs) <- ordNubBy (\(name, _, _) -> name) macros
+  ]
+  where
+    z = cabalMacros pkg_descr lbi clbi
+    macros =
+      concat
+        [ versionMacros "" (Z.zManglePkgName z (Z.zpkgName p)) (Z.zpkgVersion p) (Z.zpkgX p, Z.zpkgY p, Z.zpkgZ p)
+        | p <- Z.zPackages z
+        ]
+        ++ concat
+          [ versionMacros "TOOL_" (Z.zMangleStr z (Z.ztoolName t)) (Z.ztoolVersion t) (Z.ztoolX t, Z.ztoolY t, Z.ztoolZ t)
+          | t <- Z.zTools z
+          ]
+        ++ [constant "CURRENT_PACKAGE_KEY" (Z.zPackageKey z) | Z.zNotNull z (Z.zPackageKey z)]
+        ++ [constant "CURRENT_COMPONENT_ID" (Z.zComponentId z) | Z.zNotNull z (Z.zComponentId z)]
+        ++ [constant "CURRENT_PACKAGE_VERSION" (prettyShow (Z.zPackageVersion z))]
+    constant name value = (name, name, "\"" ++ value ++ "\"")
+    versionMacros kind name version (x, y, minor) =
+      [ constant (kind ++ "VERSION_" ++ name) (prettyShow version)
+      , let macro = "MIN_" ++ kind ++ "VERSION_" ++ name
+         in ( macro
+            , macro ++ "(major1,major2,minor)"
+            , concat
+                [ "((major1)<" ++ x
+                , "||(major1)==" ++ x ++ "&&(major2)<" ++ y
+                , "||(major1)==" ++ x ++ "&&(major2)==" ++ y ++ "&&(minor)<=" ++ minor
+                , ")"
+                ]
+            )
+      ]
+
+-- | The data of the @cabal_macros.h@ for the given configured package.
+cabalMacros :: PackageDescription -> LocalBuildInfo -> ComponentLocalBuildInfo -> Z.Z
+cabalMacros pkg_descr lbi clbi =
+  Z.Z
+    { Z.zPackages = map mkZPackage $ package pkg_descr : map getPid (componentPackageDeps clbi)
+    , Z.zTools =
+        [ Z.ZTool
             { Z.ztoolName = programId prog
             , Z.ztoolVersion = ver
             , Z.ztoolX = major1
             , Z.ztoolY = major2
             , Z.ztoolZ = minor
             }
-          | prog <- configuredPrograms $ withPrograms lbi
-          , ver <- maybeToList (programVersion prog)
-          , let (major1, major2, minor) = majorMinor ver
-          ]
-      , Z.zPackageKey = case clbi of
-          LibComponentLocalBuildInfo{componentCompatPackageKey = compatPackageKey} -> compatPackageKey
-          _ -> ""
-      , Z.zComponentId = prettyShow (componentComponentId clbi)
-      , Z.zPackageVersion = pkgVersion (package pkg_descr)
-      , Z.zNotNull = not . null
-      , Z.zManglePkgName = map fixchar . unPackageName
-      , Z.zMangleStr = map fixchar
-      }
+        | prog <- configuredPrograms $ withPrograms lbi
+        , ver <- maybeToList (programVersion prog)
+        , let (major1, major2, minor) = majorMinor ver
+        ]
+    , Z.zPackageKey = case clbi of
+        LibComponentLocalBuildInfo{componentCompatPackageKey = compatPackageKey} -> compatPackageKey
+        _ -> ""
+    , Z.zComponentId = prettyShow (componentComponentId clbi)
+    , Z.zPackageVersion = pkgVersion (package pkg_descr)
+    , Z.zNotNull = not . null
+    , Z.zManglePkgName = map fixchar . unPackageName
+    , Z.zMangleStr = map fixchar
+    }
   where
     getPid (_, MungedPackageId (MungedPackageName pn _) v) =
       -- NB: Drop the library name! We're just reporting package versions.
