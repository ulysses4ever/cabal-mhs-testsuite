+-- | Install any built library for MicroHs, which finds libraries in package
+-- directories rather than through environment files: into the package
+-- directory of the user, or into the one given with --package-env.
+installLibrariesForMhs
+  :: Verbosity
+  -> ProjectBuildContext
+  -> Compiler
+  -> PackageDBStackCWD
+  -> ProgramDb
+  -> ClientInstallFlags
+  -> IO ()
+installLibrariesForMhs verbosity buildCtx compiler packageDbs progDb clientInstallFlags = do
+  -- The packages as they are now, with the libraries just built.
+  installedIndex <- getInstalledPackages verbosity compiler packageDbs progDb
+  mbDir <- traverse makeAbsolute (flagToMaybe (cinstEnvironmentPath clientInstallFlags))
+  MHS.installInPackageDirectory
+    verbosity
+    compiler
+    progDb
+    installedIndex
+    [unitId | GhcEnvFilePackageId unitId <- entriesForLibraryComponents (targetsMap buildCtx)]
+    mbDir
+
