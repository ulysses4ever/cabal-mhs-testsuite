+-- | Rewrite the descriptions of all the source packages, as a compiler may
+-- need them, given which packages the solver can choose from: see
+-- 'Distribution.Simple.Configure.packageDescriptionForCompiler'.
+rewriteSourcePackages
+  :: ((PackageName -> Bool) -> PD.GenericPackageDescription -> PD.GenericPackageDescription)
+  -> DepResolverParams
+  -> DepResolverParams
+rewriteSourcePackages rewrite params =
+  params
+    { depResolverSourcePkgIndex =
+        (\srcPkg -> srcPkg{srcpkgDescription = rewrite available (srcpkgDescription srcPkg)})
+          <$> sourcePkgIndex
+    }
+  where
+    sourcePkgIndex = depResolverSourcePkgIndex params
+    available name =
+      not (null (PackageIndex.lookupPackageName sourcePkgIndex name))
+        || not (null (InstalledPackageIndex.lookupPackageName (depResolverInstalledPkgIndex params) name))
+
 addSourcePackages
   :: [UnresolvedSourcePackage]
   -> DepResolverParams
