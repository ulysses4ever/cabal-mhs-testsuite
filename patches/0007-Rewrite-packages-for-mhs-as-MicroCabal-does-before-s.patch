+-- | The package description as the compiler builds the package, as far as
+-- the packages it uses instead are available, which the predicate says:
+-- MicroHs builds packages as MicroCabal rewrites them. cabal-install rewrites
+-- the packages it gives to the solver the same way.
+packageDescriptionForCompiler
+  :: Compiler -> (PackageName -> Bool) -> GenericPackageDescription -> GenericPackageDescription
+packageDescriptionForCompiler comp =
+  case compilerFlavor comp of
+    MHS -> MHS.rewritePackageDescription
+    _ -> const id
+
 preConfigurePackage
   :: ConfigFlags
   -> GenericPackageDescription
